{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shellslatee",
  "version": "0.3.0",
  "identifier": "app.shellslatee.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A local-first study cockpit for your own lectures",
    "longDescription": "Shellslatee turns your lectures, slides and PDFs into linked notes, flashcards, quizzes and a cited tutor. Notes stay as plain Markdown on your disk; you bring your own model key.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
